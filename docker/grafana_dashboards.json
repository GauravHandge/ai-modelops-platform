  "panels": [
    {
      "title": "ModelOps - Prediction Throughput (Req/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{handler=~\"/api/models/.*/predict\"}[1m]))",
          "legendFormat": "Inference Requests"
        }
      ]
    },
    {
      "title": "P99 Inference Latency (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{handler=~\"/api/models/.*/predict\"}[5m])) by (le)) * 1000",
          "legendFormat": "P99 Latency (ms)"
        }
      ]
    },
    {
      "title": "Active Data Drift Events",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "modelops_open_drift_events_total",
          "legendFormat": "Open Drift Events"
        }
      ]
    }
  ],
