# AI ModelOps Platform - Environment Variables

PROJECT_NAME="AI ModelOps Platform"
ENV="development"
DEBUG=True

# Database Configuration (SQLite default for local, PostgreSQL for Docker)
DATABASE_URL="sqlite:///./modelops.db"
# DATABASE_URL="postgresql://modelops_user:modelops_password@localhost:5432/modelops_db"

# Security & JWT
SECRET_KEY="modelops-super-secret-jwt-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MLflow Integration
MLFLOW_TRACKING_URI="./mlflow_artifacts"
MLFLOW_EXPERIMENT_NAME="modelops_experiments"

# Model Storage Directory
MODEL_STORE_DIR="./storage/models"
DATASET_STORE_DIR="./storage/datasets"

# Server Ports
PORT=8000
FRONTEND_PORT=3000
